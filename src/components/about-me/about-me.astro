<style>
    .spacer {
        height: 0;
    }

    .wrapper {
        height: 150vh;
        position: relative;
        top: -100px;
    }
    .panel {
        position: sticky;
        top: 50px;
        color: rgb(0, 0, 0);
    }

    .contenido {
        height: 200vh;
        padding: 40px;
        position: absolute;
        width: 100%;
        border: 1px solid red;
    }

    .contenido2 {
        height: 200vh;
        padding: 40px;
        width: 100%;
    }

    p {
        font-size: 8rem;
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 50% cover 50%;
        font-weight: bold;
        animation-delay: calc(sibling-index() * 1s);
        line-height: 0.9;
        text-align: center;
        letter-spacing: -3px;
    }

    @keyframes reveal {
        0% {
            transform: translateY(500px);
            opacity: 0;
        }
        90% {
            opacity: 0;
        }
        98% {
            transform: translateY(-5px);
            opacity: 1;
        }
        100% {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* 📱 MEDIA QUERY para pantallas más pequeñas (Móviles y Tablets) */
    @media (max-width: 768px) {
        .spacer {
            display: none;
        }

        p {
            font-size: clamp(2.35rem, 11vw, 4.25rem);
            line-height: 1.05;
            letter-spacing: 0;
            padding: 0;
            text-wrap: balance;
            animation: none;
        }

        .wrapper {
            height: auto;
            min-height: 100dvh;
            top: 0;
            padding: clamp(3rem, 12vh, 6rem) clamp(1rem, 5vw, 2rem);
            box-sizing: border-box;
        }

        .panel {
            position: static;
            display: grid;
            gap: clamp(0.75rem, 2.5vh, 1.5rem);
            width: min(100%, 34rem);
            margin-inline: auto;
        }
    }

    @media (max-width: 380px) {
        p {
            font-size: 2.25rem;
        }
    }
</style>

<section>
    <section class="spacer"></section>

    <section class="wrapper">
        <div class="panel">
            <p>APIs, SQL & <span class="text-pink-500">Performance</span></p>
            <p>UX & Business <span class="text-yellow-500">Focused</span></p>
            <p>Software <span class="text-violet-700">Developer</span></p>
            <p>End-to-End <span class="text-blue-500">Apps</span></p>
            <p>Based in <span class="text-red-500">Spain</span></p>
        </div>
        <!-- <section class="contenido">
            <h1>Contenido largo...</h1>
        </section> -->
    </section>
    <!-- <section class="contenido2">
        <h1>Contenido largo...</h1>
    </section> -->
</section>
